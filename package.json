{
  "name": "s8s-mail",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#shared": "./shared/src/index.ts"
  },
  "scripts": {
    "wrangler": "wrangler",
    "dev": "pnpm opaque:prepare && vite dev",
    "build": "pnpm typecheck && vite build && node web/scripts/fetch-webmail.mjs",
    "preview": "vite preview",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "pnpm opaque:prepare && tsc -p . && tsc -p server && tsc -p web && tsc -p shared",
    "test": "pnpm opaque:prepare && vitest run",
    "coverage": "pnpm opaque:prepare && vitest run --coverage",
    "cf-typegen": "wrangler types server/worker-configuration.d.ts --strict-vars=false",
    "db:generate:d1": "drizzle-kit generate --config server/drizzle.config.d1.ts",
    "db:generate:do": "drizzle-kit generate --config server/drizzle.config.do.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "opaque:prepare": "node server/scripts/prepare-opaque.mjs",
    "opaque:setup": "node server/scripts/create-opaque-setup.mjs"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.7",
    "@better-auth/oauth-provider": "1.7.7",
    "@better-auth/passkey": "1.7.7",
    "@hono/zod-validator": "^0.9.1",
    "@hookform/resolvers": "^5.9.1",
    "@serenity-kit/opaque": "1.1.0",
    "@tabler/icons-react": "^3.49.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "postal-mime": "^4.0.5",
    "radix-ui": "^1.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "react-router": "^8.4.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-istanbul": "4.1.11",
    "cf": "1.0.0-beta.14",
    "drizzle-kit": "^0.31.11",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.3.4",
    "vitest": "4.1.11",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
