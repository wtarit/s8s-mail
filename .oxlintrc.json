{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "es2023": true,
    "browser": true
  },
  "rules": {
    "no-console": ["error", { "allow": ["error", "warn", "info"] }],
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "max-lines": ["error", { "max": 300, "skipBlankLines": true, "skipComments": true }],
    "typescript/no-explicit-any": "warn",
    "typescript/consistent-type-imports": "error",
    "import/no-duplicates": "error",
    "import/no-unassigned-import": "off",
    "react/react-in-jsx-scope": "off",
    "react/jsx-key": "error"
  },
  "overrides": [
    {
      "files": ["**/test/**", "**/*.test.ts", "**/*.test.tsx"],
      "rules": { "no-console": "off" }
    },
    {
      "files": ["server/src/db/auth-schema.ts", "web/src/i18n/en.ts"],
      "rules": { "max-lines": "off" }
    },
    {
      "files": ["server/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/web/**", "**/shared/**"],
                "message": "The server must work without the frontend. Import shared code from #shared."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["web/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/server/**", "**/shared/**"],
                "message": "The SPA talks to the server over HTTP only. Import shared code from #shared."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/server/**", "**/web/**"],
                "message": "shared/ is imported by both sides and must not depend on either."
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.wrangler/**",
    "**/worker-configuration.d.ts",
    "web/src/components/ui/**",
    "**/drizzle/**"
  ]
}
