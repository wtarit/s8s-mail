{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "s8s-mail",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": { "enabled": true },

  // The SPA (web/dist). In SPA mode, browser navigations are answered with index.html
  // without running the Worker, so every path a browser navigates to that the Worker must
  // handle (OAuth authorize, /.well-known/*, downloads) has to be in run_worker_first.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/jmap/*", "/.well-known/*"],
  },

  // Import *.sql as text (drizzle durable-sqlite migrations import their SQL files).
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "s8s-mail",
      // TODO(deploy): placeholder. Replace with the real id from `wrangler d1 create s8s-mail`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle/d1",
    },
  ],

  "r2_buckets": [
    {
      "binding": "BLOBS",
      // TODO(deploy): create the bucket (`wrangler r2 bucket create s8s-mail-blobs`).
      "bucket_name": "s8s-mail-blobs",
    },
  ],

  "durable_objects": {
    "bindings": [{ "name": "ACCOUNT", "class_name": "AccountDO" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccountDO"] }],

  // Non-secret vars only. Secrets (MAILGUN_API_KEY, BETTER_AUTH_SECRET, ...) go through
  // `wrangler secret put` and `.dev.vars` locally; never in this file.
  "vars": {
    "APP_NAME": "S8S Mail",
    "MAIL_PROVIDER": "mailgun",
    "MAILGUN_REGION": "us",
  },
}
