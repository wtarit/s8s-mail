# Copy to .dev.vars (gitignored) for `wrangler dev`. In production use `wrangler secret put <NAME>`.

# Better Auth signing/encryption secret: at least 32 random characters (e.g. `openssl rand -base64 48`).
BETTER_AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Bearer token for POST /api/bootstrap (creates the first admin; only works while there are no users).
# Generate with `openssl rand -base64 32` and delete the secret after bootstrapping.
BOOTSTRAP_TOKEN=replace-with-a-random-token

# Mailgun API key for the send module (see server/src/send).
MAILGUN_API=
